# Neon → your project → Connect. Use the POOLED string (host contains "-pooler") here:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"
# ...and the DIRECT string (no "-pooler") here — used by `prisma migrate`:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# http://localhost:3000 locally; your https://*.vercel.app URL in production
BETTER_AUTH_URL="http://localhost:3000"
